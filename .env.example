# .env.example

# ====================
# Database configuration
# ====================
DB_HOST=database
DB_PORT=5432
DB_NAME=saas_db
DB_USER=postgres
DB_PASSWORD=postgres

# ====================
# JWT configuration
# ====================
JWT_SECRET=your-secret-key-32chars-long
JWT_EXPIRES_IN=24h

# ====================
# Server configuration
# ====================
PORT=5000
NODE_ENV=development

# ====================
# Frontend URL (CORS)
# ====================
FRONTEND_URL=http://frontend:3000

# ====================
# Optional email configuration (unused in demo)
# ====================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=