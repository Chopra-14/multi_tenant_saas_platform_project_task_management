/api/users/:userId\nrouter.put('/users/:userId', param('userId').isUUID(), body().custom(() => true), updateUser);\n\n// DELETE /api/users/:userId\nrouter.delete('/users/:userId', param('userId').isUUID(), deleteUser);\n\nmodule.exports = router;\n","Overwrite":true,"Path":"C:\\Users\\Chopra\\.gemini\\antigravity\\brain\\cf02744f-c349-45ed-b334-ab43f46fdf7b\\backend\\src\\routes\\users.js"}}]}
