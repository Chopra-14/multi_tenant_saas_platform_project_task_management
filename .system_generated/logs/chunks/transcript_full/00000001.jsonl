nants\n  } else {\n    req.tenantFilter = { tenant_id: tenantId };\n  }\n  next();\n}\n\nmodule.exports = tenantIsolation;\n","Overwrite":true,"Path":"C:\\Users\\Chopra\\.gemini\\antigravity\\brain\\cf02744f-c349-45ed-b334-ab43f46fdf7b\\backend\\src\\middleware\\tenantIsolation.js"}}]}
