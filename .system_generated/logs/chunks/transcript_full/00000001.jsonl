ing node and nginx), `frontend/vite.config.js`, `frontend/src/main.jsx`, `frontend/src/App.jsx`, `frontend/src/api/index.js`, pages placeholders.\n\nAlso create `submission.json`.\n\nLet's write these files.\n\n","tool_calls":[{"name":"write_file","args":{"Content":"// src/middleware/rbac.js\n\n/**\n * Role‑based access control middleware.\n * Usage: rbac(['super_admin', 'tenant_admin'])\n */\nfunction rbac(allowedRoles) {\n  return (req, res, next) => {\n    if (!req.user) {\n      return res.status(401).json({ success: false, message: 'Unauthenticated' });\n    }\n    const { role } = req.user;\n    if (allowedRoles.includes(role)) {\n      return next();\n    }\n    return res.status(403).json({ success: false, message: 'Forbidden: insufficient role' });\n  };\n}\n\nmodule.exports = rbac;\n","Overwrite":true,"Path":"C:\\Users\\Chopra\\.gemini\\antigravity\\brain\\cf02744f-c349-45ed-b334-ab43f46fdf7b\\backend\\src\\middleware\\rbac.js"}}]}
