login, me, logout } = require('../controllers/authController');\nconst auth = require('../middleware/auth');\n\nconst router = express.Router();\n\n// Register Tenant (public)\nrouter.post(\n  '/register-tenant',\n  [\n    body('tenantName').isString().notEmpty(),\n    body('subdomain').isString().matches(/^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/),\n    body('adminEmail').isEmail(),\n    body('adminPassword').isLength({ min: 8 }),\n    body('adminFullName').isString().notEmpty()\n  ],\n  registerTenant\n);\n\n// Login (public)\nrouter.post(\n  '/login',\n  [\n    body('email').isEmail(),\n    body('password').isString().notEmpty(),\n    body('tenantSubdomain').optional().isString()\n  ],\n  login\n);\n\n// Get current user (protected)\nrouter.get('/me', auth, me);\n\n// Logout (protected)\nrouter.post('/logout', auth, logout);\n\nmodule.exports = router;\n","Overwrite":true,"Path":"C:\\Users\\Chopra\\.gemini\\antigravity\\brain\\cf02744f-c349-45ed-b334-ab43f46fdf7b\\backend\\src\\routes\\auth.js"}}]}
