RT || 5000;\napp.listen(PORT, () => {\n  console.log(`Backend listening on port ${PORT}`);\n});\n\nmodule.exports = app;\n","Overwrite":true,"Path":"C:\\Users\\Chopra\\.gemini\\antigravity\\brain\\cf02744f-c349-45ed-b334-ab43f46fdf7b\\backend\\src\\app.js"}}]}
